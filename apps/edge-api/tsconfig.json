{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "paths": {
      "@shared/*": ["./supabase/functions/_shared/*"],
      "@supabase/functions-js/edge-runtime.d.ts": [
        "./node_modules/@supabase/functions-js/src/edge-runtime.d.ts",
        "../../node_modules/@supabase/functions-js/src/edge-runtime.d.ts"
      ]
    },
    "rootDir": "./supabase/functions",
    "strict": true,
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"],
    "types": ["node"]
  },
  "exclude": ["dist/**", "node_modules/**", "supabase/.branches/**", "supabase/.temp/**", "supabase/migrations/**"],
  "extends": "../../tsconfig.base.json",
  "include": ["supabase/functions/**/*"]
}
