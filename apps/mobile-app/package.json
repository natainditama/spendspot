{
  "name": "@spendspot/mobile-app",
  "version": "1.0.0",
  "private": true,
  "description": "Smart expense and budget tracker with AI geofencing",
  "main": "expo-router/entry",
  "scripts": {
    "build": "eas build --platform all",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "dev": "expo start --go",
    "doctor": "node ../../scripts/expo-doctor.mjs",
    "lint": "expo lint",
    "start": "expo start",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@spendspot/core-logic": "workspace:*",
    "@spendspot/ui-components": "workspace:*",
    "@tamagui/config": "^2.7.7",
    "@tamagui/core": "^2.7.7",
    "@tamagui/lucide-icons": "^2.0.0-rc.26",
    "babel-preset-expo": "^57.0.12",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7"
  },
  "devDependencies": {
    "expo-doctor": "^1.20.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-constants",
        "expo-font",
        "expo-linking",
        "@expo/dom-webview",
        "@expo/log-box"
      ]
    }
  }
}
