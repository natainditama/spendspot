{
  "name": "@spendspot/mobile-app",
  "version": "1.0.0",
  "private": true,
  "description": "Smart expense and budget tracker with AI geofencing",
  "main": "expo-router/entry",
  "scripts": {
    "build": "eas build --platform all",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "dev": "expo start --go",
    "doctor": "node ../../scripts/expo-doctor.mjs",
    "lint": "expo lint",
    "start": "expo start",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@spendspot/core-logic": "workspace:*",
    "@spendspot/ui-components": "workspace:*",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-image": "^57.0.5",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~2.33.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "babel-preset-expo": "^57.0.13",
    "expo-doctor": "^1.20.4"
  }
}
