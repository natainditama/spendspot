{
  "name": "@spendspot/mobile-app",
  "version": "1.0.0",
  "private": true,
  "description": "Smart expense and budget tracker with AI geofencing",
  "main": "expo-router/entry",
  "scripts": {
    "build": "eas build --platform all",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "dev": "expo start --go",
    "doctor": "node ../../scripts/expo-doctor.mjs",
    "lint": "expo lint",
    "start": "expo start",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@spendspot/core-logic": "workspace:*",
    "@spendspot/ui-components": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-maps": "^1.29.11",
    "react-native-reanimated": "4.8.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.14.0"
  },
  "devDependencies": {
    "babel-preset-expo": "~58.0.23",
    "expo-doctor": "^1.21.5"
  }
}
