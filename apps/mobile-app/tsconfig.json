{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@spendspot/ui-components/*": ["../../packages/ui-components/src/*/index.tsx"],
      "react-native": ["./node_modules/react-native"],
      "react-native/*": ["./node_modules/react-native/*"]
    },
    "strict": true,
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"],
    "types": ["react", "node"]
  },
  "exclude": ["node_modules", "dist"],
  "extends": ["../../tsconfig.base.json", "expo/tsconfig.base"],
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts", "metro.config.ts"]
}
