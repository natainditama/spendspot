{
  "$schema": "https://json.schemastore.org/prettierrc.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "", "^@spendspot/(.*)$", "", "^@/(.*)$", "", "^[./]"],
  "importOrderParserPlugins": ["typescript", "jsx"],
  "jsdocEmptyCommentStrategy": "keep",
  "jsdocPrintWidth": 80,
  "plugins": [
    "prettier-plugin-sort-json",
    "prettier-plugin-packagejson",
    "@lebedevna/prettier-plugin-sql",
    "@ianvs/prettier-plugin-sort-imports"
  ],
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false
}
