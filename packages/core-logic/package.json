{
  "name": "@spendspot/core-logic",
  "version": "1.0.0",
  "private": true,
  "description": "Shared business logic and state management for SpendSpot",
  "exports": {
    "./components/*": "./src/components/*",
    "./hooks/*": "./src/hooks/*",
    "./constants/*": "./src/constants/*",
    "./i18n": "./src/i18n/index.ts",
    "./utils/*": "./src/lib/utils/*",
    "./lib/*": "./src/lib/*",
    "./services": "./src/services/index.ts",
    "./services/*": "./src/services/*",
    "./providers": "./src/providers/index.ts",
    "./providers/*": "./src/providers/*",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch",
    "lint": "eslint .",
    "start": "tsc --noEmit --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@spendspot/ui-components": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "i18next": "^26.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react-i18next": "^17.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "expo-router": "^58.0.29",
    "react-native-maps": "^1.29.11"
  },
  "peerDependencies": {
    "expo-router": "*",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-maps": "*"
  }
}
