{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "paths": {
      "@spendspot/core-logic/*": ["./src/*"]
    },
    "rootDir": "./src",
    "strict": true,
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"],
    "types": ["react", "node"]
  },
  "exclude": ["dist/**", "node_modules/**"],
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"]
}
