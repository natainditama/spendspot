{
  "name": "@spendspot/ui-components",
  "version": "1.0.0",
  "private": true,
  "description": "Shared React Native UI component library for SpendSpot",
  "exports": {
    "./*": "./src/*/index.tsx",
    "./button": "./src/button/index.tsx",
    "./checkbox": "./src/checkbox/index.tsx",
    "./input": "./src/input/index.tsx",
    "./provider": "./src/provider/index.tsx"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch",
