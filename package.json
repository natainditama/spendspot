{
  "name": "spendspot",
  "version": "1.0.0",
  "private": true,
  "description": "Smart location expense and commute budget tracker with AI",
  "keywords": [
    "expense",
    "budget",
    "tracker"
  ],
  "homepage": "https://github.com/natainditama/spendspot",
  "bugs": {
    "url": "https://github.com/natainditama/spendspot/issues",
    "email": "natainditama.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/natainditama/spendspot"
  },
  "license": "MIT",
  "author": {
    "name": "natainditama",
    "email": "natainditama.dev@gmail.com",
    "url": "https://github.com/natainditama"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter \"*\" build",
    "commitlint": "commitlint --edit",
    "dev:edge": "bun --filter @spendspot/edge-api dev",
    "dev:mobile": "bun --filter @spendspot/mobile-app dev",
    "format": "prettier --write .",
    "lint": "bun --filter \"*\" lint",
    "prepare": "husky",
    "start:edge": "bun --filter @spendspot/edge-api start",
    "start:mobile": "bun --filter @spendspot/mobile-app start",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "bun --filter \"*\" typecheck",
    "typecheck:staged": "node scripts/typecheck.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bun run typecheck:staged"
    ],
    "!(*.{js,jsx,ts,tsx})": [
      "prettier --write --ignore-unknown"
    ]
  },
  "resolutions": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "lightningcss": "1.30.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "overrides": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "lightningcss": "1.30.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@lebedevna/prettier-plugin-sql": "^0.3.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.10.13",
    "eslint-config-universe": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
