{
  "name": "spendspot",
  "version": "1.0.0",
  "private": true,
  "description": "Smart location expense and commute budget tracker with AI",
  "keywords": [
    "expense",
    "budget",
    "tracker"
  ],
  "homepage": "https://github.com/natainditama/spendspot",
  "bugs": {
    "url": "https://github.com/natainditama/spendspot/issues",
    "email": "natainditama.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/natainditama/spendspot"
  },
  "license": "MIT",
  "author": {
    "name": "natainditama",
    "email": "natainditama.dev@gmail.com",
    "url": "https://github.com/natainditama"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter \"*\" build",
    "commitlint": "commitlint --edit",
    "dev:edge": "bun --filter @spendspot/edge-api dev",
    "dev:mobile": "bun --filter @spendspot/mobile-app dev",
    "format": "prettier --write .",
    "lint": "bun --filter \"*\" lint",
    "prepare": "husky",
    "start": "bun run dev:mobile",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "bun --filter \"*\" typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --no-warn-ignored --fix",
      "prettier --write"
    ],
    "!(*.{js,jsx,ts,tsx})": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@lebedevna/prettier-plugin-sql": "^0.3.2",
    "@types/node": "^26.5.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
