{
  "name": "spendspot",
  "version": "1.0.0",
  "private": true,
  "description": "Smart location expense and commute budget tracker with AI",
  "homepage": "https://github.com/natainditama/spendspot",
  "bugs": {
    "url": "https://github.com/natainditama/spendspot/issues",
    "email": "natainditama.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/natainditama/spendspot"
  },
  "author": {
    "name": "natainditama",
    "email": "natainditama.dev@gmail.com",
    "url": "https://github.com/natainditama"
  },
  "license": "MIT",
  "keywords": [
    "expense",
    "budget",
    "tracker"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter \"*\" build",
    "commitlint": "commitlint --edit",
    "dev:edge": "bun --filter @spendspot/edge-api dev",
    "dev:mobile": "bun --filter @spendspot/mobile-app dev",
    "format": "prettier --write .",
    "lint": "bun --filter \"*\" lint",
    "prepare": "husky",
    "start": "bun run dev:mobile",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "bun --filter \"*\" typecheck"
  },
  "lint-staged": {
    "./src/**/*.{ts,js,jsx,tsx}": [
      "prettier --ignore-path .gitignore --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-sort-json": "^4.2.0",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-sort-json"
    ],
    "printWidth": 120,
    "trailingComma": "es5",
    "singleQuote": true,
    "tabWidth": 2,
    "endOfLine": "auto"
  }
}
